    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "admin:grant": "tsx scripts/grant-development-admin.ts"
  },
  "prisma": {"seed": "tsx prisma/seed.ts"},
  "dependencies": {"@prisma/client": "6.19.3"},
  "devDependencies": {"prisma": "6.19.3", "tsx": "catalog:", "typescript": "~5.9.3", "@types/node": "catalog:"}
}
