{
  "name": "@workspace/saudisensei-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {".": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}},
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
