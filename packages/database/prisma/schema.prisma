generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  deleted
  @@map("user_status")
}

enum RoleName {
  student
  admin
  @@map("role_name")
}

enum ContentStatus {
  draft
  published
  archived
  @@map("content_status")
}

enum EnrollmentStatus {
  active
  revoked
  expired
  @@map("enrollment_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @db.VarChar(320)
  displayName     String     @map("display_name") @db.VarChar(120)
  status          UserStatus @default(active)
  preferredLocale String     @default("ar") @map("preferred_locale") @db.VarChar(2)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  identities      UserIdentity[]
  roles           UserRole[] @relation("AssignedRoles")
  roleGrants      UserRole[] @relation("RoleGrantor")
  courses         Course[]
  enrollments     Enrollment[] @relation("EnrolledStudent")
  enrollmentGrants Enrollment[] @relation("EnrollmentGrantor")
  auditLogs       AuditLog[]
  mediaAssets     MediaAsset[]
  mediaUploads    MediaUploadSession[]
  authoredContentMedia ContentMediaAsset[]
  authoredMediaRevisions MediaRevision[]
  processingUploads MediaProcessingUpload[]
  assessmentQuestions Question[]
  assessmentQuestionRevisions QuestionRevision[]
  assessmentQuizzes Quiz[]
  assessmentQuizRevisions QuizRevision[]
  assessmentReviewReleases QuizReviewRelease[]
  assessmentMutations AssessmentMutation[]
  assessmentContentLinks SkillContentLink[]
  @@index([email])
  @@index([status])
  @@map("users")
}

model UserIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  issuer    String   @db.VarChar(512)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([issuer, subject])
  @@index([userId])
  @@map("user_identities")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name RoleName @unique
  users UserRole[]
  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  user      User @relation("AssignedRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantor   User? @relation("RoleGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Course {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique @db.VarChar(160)
  title       String @db.VarChar(255)
  description String @default("") @db.Text
  status      ContentStatus @default(draft)
  editRevision Int @default(0) @map("edit_revision")
  createdBy   String @map("created_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator     User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  chapters    Chapter[]
  contentMedia ContentMediaAsset[]
  mediaCollections MediaCollection[]
  mediaPlacements MediaPlacement[]
  mediaState CourseMediaState?
  enrollments Enrollment[]
  quizzes Quiz[]
  skillContentLinks SkillContentLink[]
  @@index([status])
  @@map("courses")
}

model Chapter {
  id         String @id @default(uuid()) @db.Uuid
  courseId   String @map("course_id") @db.Uuid
  title      String @db.VarChar(255)
  status     ContentStatus @default(draft)
  position   Int
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessons    Lesson[]
  mediaCollections MediaCollection[]
  mediaPlacements MediaPlacement[]
  quizzes Quiz[]
  skillContentLinks SkillContentLink[]
  @@unique([id, courseId])
  @@unique([courseId, position])
  @@index([courseId, status, position])
  @@map("chapters")
}

model Lesson {
  id               String @id @default(uuid()) @db.Uuid
  chapterId        String @map("chapter_id") @db.Uuid
  courseId         String @map("course_id") @db.Uuid
  title            String @db.VarChar(255)
  body             String @default("") @db.Text
  status           ContentStatus @default(draft)
  isRequired       Boolean @default(true) @map("is_required")
  position         Int
  estimatedMinutes Int? @map("estimated_minutes")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapter          Chapter @relation(fields: [chapterId, courseId], references: [id, courseId], onDelete: Restrict)
  completions      LessonCompletion[]
  media            MediaAsset[]
  videoPilotAssets VideoPilotAsset[]
  mediaCollections MediaCollection[]
  mediaPlacements MediaPlacement[]
  quizzes Quiz[]
  skillContentLinks SkillContentLink[]
  @@unique([id, chapterId, courseId], map: "lessons_media_ancestry_key")
  @@unique([id, courseId])
  @@unique([chapterId, position])
  @@index([courseId, status, isRequired])
  @@map("lessons")
}

model Enrollment {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  courseId   String @map("course_id") @db.Uuid
  status     EnrollmentStatus @default(active)
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  grantedBy  String @map("granted_by") @db.Uuid
  student    User @relation("EnrolledStudent", fields: [userId], references: [id], onDelete: Restrict)
  grantor    User @relation("EnrollmentGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  completions LessonCompletion[]
  assessmentAttempts AssessmentAttempt[]
  @@unique([userId, courseId])
  @@unique([id, courseId])
  @@unique([id, userId, courseId], map: "enrollments_assessment_owner_key")
  @@index([courseId, status])
  @@index([userId, status])
  @@map("enrollments")
}

model LessonCompletion {
  id           String @id @default(uuid()) @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  lessonId     String @map("lesson_id") @db.Uuid
  courseId     String @map("course_id") @db.Uuid
  completedAt  DateTime @default(now()) @map("completed_at") @db.Timestamptz(6)
  enrollment   Enrollment @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Restrict)
  lesson       Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Restrict)
  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_completions")
}

model AuditLog {
  id          String @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action      String @db.VarChar(100)
  entityType  String @map("entity_type") @db.VarChar(100)
  entityId    String? @map("entity_id") @db.Uuid
  requestId   String? @map("request_id") @db.Uuid
  metadata    Json @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model MediaAsset {
  id            String @id @default(uuid()) @db.Uuid
  lessonId      String @map("lesson_id") @db.Uuid
  courseId      String @map("course_id") @db.Uuid
  revisionRef   String @unique @map("revision_ref") @db.Uuid
  title         String @db.VarChar(255)
  mimeType      String @map("mime_type") @db.VarChar(100)
  bytes         Int
  objectKey     String @unique @map("object_key") @db.VarChar(512)
  previewKey    String? @unique @map("preview_key") @db.VarChar(512)
  sha256        String? @db.VarChar(64)
  scanState     String @default("pending") @map("scan_state") @db.VarChar(16)
  scannedAt     DateTime? @map("scanned_at") @db.Timestamptz(6)
  scanEngine    String? @map("scan_engine") @db.VarChar(120)
  status        ContentStatus @default(draft)
  downloadsAllowed Boolean @default(true) @map("downloads_allowed")
  createdBy     String @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson        Lesson @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Restrict)
  creator       User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  upload        MediaUploadSession?
  @@index([lessonId, status, scanState])
  @@map("media_assets")
}

// Bounded development fixture metadata only; never video bytes or signed tokens.
model VideoPilotAsset {
  id          String @id @default(uuid()) @db.Uuid
  fixture     String @unique @db.VarChar(8)
  provider    String @default("cloudflare-stream") @db.VarChar(40)
  providerRef String @unique @map("provider_ref") @db.VarChar(64)
  playbackHost String @map("playback_host") @db.VarChar(255)
  sourceKey   String @unique @map("source_key") @db.VarChar(512)
  sha256      String @db.VarChar(64)
  bytes       Int
  duration    Int
  scanEngine  String @map("scan_engine") @db.VarChar(120)
  scannedAt   DateTime @map("scanned_at") @db.Timestamptz(6)
  privateReady Boolean @default(false) @map("private_ready")
  status      ContentStatus @default(draft)
  lessonId    String? @map("lesson_id") @db.Uuid
  courseId    String? @map("course_id") @db.Uuid
  lesson      Lesson? @relation(fields: [lessonId, courseId], references: [id, courseId], onDelete: Restrict)
  @@index([lessonId, status])
  @@map("video_pilot_assets")
}

model MediaUploadSession {
  id            String @id @default(uuid()) @db.Uuid
  assetId       String @unique @map("asset_id") @db.Uuid
  uploaderId    String @map("uploader_id") @db.Uuid
  stagingKey    String @unique @map("staging_key") @db.VarChar(512)
  providerUploadId String? @map("provider_upload_id") @db.Text
  method        String @db.VarChar(16)
  state         String @default("issued") @db.VarChar(16)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  asset         MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  uploader      User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  @@index([uploaderId, state, expiresAt])
  @@map("media_upload_sessions")
}

// General authoring foundation. Pilot tables above remain untouched.
// Parent shape checks and immutable-content triggers are in the additive migration.
model ContentMediaAsset {
  id String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  kind String @db.VarChar(16)
  title String @db.VarChar(255)
  status String @default("draft") @db.VarChar(16)
  downloadsAllowed Boolean @default(false) @map("downloads_allowed")
  currentRevisionId String? @map("current_revision_id") @db.Uuid
  stagedRevisionId String? @map("staged_revision_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions MediaRevision[] @relation("OwnedMediaRevisions")
  currentRevision MediaRevision? @relation("CurrentMediaRevision", fields: [currentRevisionId, id, courseId], references: [id, assetId, courseId], onDelete: Restrict, onUpdate: NoAction, map: "content_media_current_owned")
  stagedRevision MediaRevision? @relation("StagedMediaRevision", fields: [stagedRevisionId, id, courseId], references: [id, assetId, courseId], onDelete: Restrict, onUpdate: NoAction, map: "content_media_staged_owned")
  placement MediaPlacement?
  @@unique([id, courseId])
  @@index([courseId, status], map: "content_media_assets_course_status")
  @@map("content_media_assets")
}

model MediaRevision {
  id String @id @default(uuid()) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid
  filename String @db.VarChar(255)
  mimeType String @map("mime_type") @db.VarChar(100)
  bytes BigInt
  state String @default("pending") @db.VarChar(16)
  scanState String @default("pending") @map("scan_state") @db.VarChar(16)
  sha256 String? @db.VarChar(64)
  scanEngine String? @map("scan_engine") @db.VarChar(120)
  scannedAt DateTime? @map("scanned_at") @db.Timestamptz(6)
  objectKey String? @map("object_key") @db.Text
  previewKey String? @map("preview_key") @db.Text
  providerRef String? @map("provider_ref") @db.Text
  privateReady Boolean @default(false) @map("private_ready")
  safePreview Boolean @default(false) @map("safe_preview")
  duration Int?
  pageCount Int? @map("page_count")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  asset ContentMediaAsset @relation("OwnedMediaRevisions", fields: [assetId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: NoAction)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currentFor ContentMediaAsset[] @relation("CurrentMediaRevision")
  stagedFor ContentMediaAsset[] @relation("StagedMediaRevision")
  processingUpload MediaProcessingUpload?
  processingJob MediaJob?
  renditions MediaRendition[]
  @@unique([id, assetId, courseId])
  @@index([assetId, createdAt], map: "media_revisions_asset_created")
  @@map("media_revisions")
}

model MediaCollection {
  id String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  parentType String @map("parent_type") @db.VarChar(16)
  parentId String @map("parent_id") @db.Uuid
  chapterId String? @map("chapter_id") @db.Uuid
  lessonId String? @map("lesson_id") @db.Uuid
  title String @db.VarChar(255)
  description String @default("") @db.VarChar(1000)
  position Int @default(0)
  status String @default("draft") @db.VarChar(16)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  chapter Chapter? @relation(fields: [chapterId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: NoAction)
  lesson Lesson? @relation(fields: [lessonId, chapterId, courseId], references: [id, chapterId, courseId], onDelete: Restrict, onUpdate: NoAction)
  placements MediaPlacement[]
  @@unique([id, courseId, parentType, parentId])
  @@index([courseId, parentType, parentId, position], map: "media_collections_parent_order")
  @@map("media_collections")
}

model MediaPlacement {
  id String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  assetId String @unique @map("asset_id") @db.Uuid
  parentType String @map("parent_type") @db.VarChar(16)
  parentId String @map("parent_id") @db.Uuid
  chapterId String? @map("chapter_id") @db.Uuid
  lessonId String? @map("lesson_id") @db.Uuid
  collectionId String? @map("collection_id") @db.Uuid
  position Int @default(0)
  status String @default("draft") @db.VarChar(16)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  asset ContentMediaAsset @relation(fields: [assetId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: NoAction)
  chapter Chapter? @relation(fields: [chapterId, courseId], references: [id, courseId], onDelete: Restrict, onUpdate: NoAction)
  lesson Lesson? @relation(fields: [lessonId, chapterId, courseId], references: [id, chapterId, courseId], onDelete: Restrict, onUpdate: NoAction)
  collection MediaCollection? @relation(fields: [collectionId, courseId, parentType, parentId], references: [id, courseId, parentType, parentId], onDelete: Restrict, onUpdate: NoAction, map: "media_placements_collection_scope_fkey")
  skillContentLinks SkillContentLink[]
  @@unique([assetId, courseId])
  @@unique([id, courseId], map: "media_placements_assessment_scope_key")
  @@index([courseId, parentType, parentId, collectionId, position], map: "media_placements_parent_order")
  @@map("media_placements")
}

model CourseMediaState {
  courseId String @id @map("course_id") @db.Uuid
  editRevision Int @default(0) @map("edit_revision")
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@map("course_media_states")
}

// Durable processing is separate from editorial publication and curriculum.
model MediaProcessingUpload {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @unique @map("revision_id") @db.Uuid
  uploaderId String @map("uploader_id") @db.Uuid
  stagingKey String @unique @map("staging_key") @db.Text
  sourceKey String @unique @map("source_key") @db.Text
  uploadRef String? @map("upload_ref") @db.Text
  method String @db.VarChar(16)
  state String @default("issued") @db.VarChar(16)
  sourceEtag String? @map("source_etag") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revision MediaRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([state, expiresAt])
  @@map("media_processing_uploads")
}

model MediaJob {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @unique @map("revision_id") @db.Uuid
  state String @default("queued") @db.VarChar(24)
  stage String @default("scan") @db.VarChar(24)
  attempts Int @default(0)
  maxAttempts Int @default(5) @map("max_attempts")
  failures Int @default(0)
  polls Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  providerRef String? @map("provider_ref") @db.Text
  errorCode String? @map("error_code") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revision MediaRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  processingAttempts MediaProcessingAttempt[]
  @@index([state, availableAt, leaseUntil], map: "media_jobs_claim")
  @@map("media_jobs")
}

model MediaProcessingAttempt {
  id String @id @default(uuid()) @db.Uuid
  jobId String @map("job_id") @db.Uuid
  number Int
  state String @default("running") @db.VarChar(24)
  errorCode String? @map("error_code") @db.VarChar(64)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  job MediaJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([jobId, number])
  @@map("media_processing_attempts")
}

model MediaRendition {
  id String @id @default(uuid()) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  kind String @db.VarChar(24)
  locator String @db.Text
  contentType String @map("content_type") @db.VarChar(100)
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(6)
  revision MediaRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@unique([revisionId, kind])
  @@map("media_renditions")
}

// Deferrable aggregate seals, checks and partial indexes are SQL-managed in
// 20261021010000_assessment_foundation. Do not replace these with db push.
model Question {
  id String @id @default(uuid()) @db.Uuid
  status String @default("active") @db.VarChar(16)
  editRevision Int @default(0) @map("edit_revision")
  currentRevisionId String? @map("current_revision_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  draft QuestionDraft?
  revisions QuestionRevision[] @relation("QuestionRevisions")
  currentRevision QuestionRevision? @relation("CurrentQuestionRevision", fields: [currentRevisionId, id], references: [id, questionId], onDelete: Restrict, onUpdate: NoAction, map: "assessment_question_current_owned")
  skills QuestionSkill[]
  cognitiveTags QuestionCognitiveTag[]
  @@map("assessment_questions")
}

model QuestionDraft {
  questionId String @id @map("question_id") @db.Uuid
  type String @db.VarChar(24)
  defaultContentLocale String @map("default_content_locale") @db.VarChar(2)
  content Json
  gradingDefinition Json @map("grading_definition")
  explanation Json
  difficulty String @db.VarChar(16)
  defaultPoints Int @default(1) @map("default_points")
  schemaVersion Int @default(1) @map("schema_version")
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@map("assessment_question_drafts")
}

model QuestionRevision {
  id String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  number Int
  type String @db.VarChar(24)
  defaultContentLocale String @map("default_content_locale") @db.VarChar(2)
  content Json
  gradingDefinition Json @map("grading_definition")
  explanation Json
  difficulty String @db.VarChar(16)
  skillSnapshot Json @map("skill_snapshot")
  cognitiveTags Json @map("cognitive_tags")
  schemaVersion Int @default(1) @map("schema_version")
  graderVersion String @map("grader_version") @db.VarChar(64)
  checksum String @db.VarChar(64)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  question Question @relation("QuestionRevisions", fields: [questionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currentFor Question[] @relation("CurrentQuestionRevision")
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  draftItems QuizDraftItem[]
  revisionItems QuizRevisionItem[]
  @@unique([questionId, number])
  @@unique([id, questionId])
  @@map("assessment_question_revisions")
}

model Skill {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(160)
  parentId String? @map("parent_id") @db.Uuid
  status String @default("active") @db.VarChar(16)
  editRevision Int @default(0) @map("edit_revision")
